# Ignore clangd cache
.cache/

# Ignore build directories (build/ is what the scripts use; the others are
# whatever your IDE decides to generate)
build/
build-*/
cmake-build-*/

# Ignore tiled-session file that contains hardcoded paths to tilemaps
*.tiled-session

# Ignore Intellij IDEs configurations
.idea/

# Add your own directories to ignore based on the IDE you use
